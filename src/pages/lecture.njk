title: Lecture
permalink: "/lecture/"
---

<div class="pdf-reader-container">

  <button id="fullscreen-btn" type="button">
    ⛶ Présentation
  </button>

  <div class="pdf-reader" id="pdf-reader">
    <iframe
      src="https://mozilla.github.io/pdf.js/web/viewer.html"
      title="Lecteur PDF"
      allow="fullscreen"
      allowfullscreen
      width="100%"
      height="100%"
      style="border: none;">
    </iframe>
  </div>

</div>

<style>
  .pdf-reader-container {
    width: 100%;
  }

  #fullscreen-btn {
    display: block;
    margin: 0 0 1rem auto;
    padding: 0.5rem 0.8rem;
    font-family: "Inconsolata", monospace;
    font-size: 1rem;
    background: none;
    border: 1px solid #888;
    color: inherit;
    cursor: pointer;
  }

  .pdf-reader {
    height: calc(100vh - 150px);
  }

  .pdf-reader iframe {
    width: 100%;
    height: 100%;
  }
</style>

<script>
  const fullscreenBtn = document.getElementById('fullscreen-btn');
  const pdfReader = document.getElementById('pdf-reader');

  fullscreenBtn.addEventListener('click', () => {
    if (pdfReader.requestFullscreen) {
      pdfReader.requestFullscreen();
    }
  });
</script>
